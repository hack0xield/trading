# Alternative to the systemd timer. crontab -e, then:
#
# Daily at 06:10 UTC. DISPLAY and WINEPREFIX must be set — cron starts with an
# almost empty environment, which is the usual reason a Wine job works by hand
# and fails on a schedule. Check `echo $DISPLAY` in the actual desktop login
# session and match it below — a wrong value doesn't fail fast, it hangs:
# Wine can't open a window on a display that isn't there, so the
# auto-launched terminal never authorizes and mt5.initialize() waits for a
# terminal that will never become ready.
10 6 * * * cd $HOME/Documents/trading && DISPLAY=:0 WINEPREFIX=$HOME/.mt5 \
  flock -w 300 /tmp/mt5.lock \
  ./.venv/bin/python scripts/run_signals.py --send --quiet \
  >> $HOME/Documents/trading/runs/signals.log 2>&1
