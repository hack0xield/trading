# Credentials — never commit these
mt5-mcp-server/config.json
strategy.txt

# Installers and downloads
*.exe
wget-log

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Editor-local preferences
.vscode/

# Backtesting data and output — regenerable, and large.
# Leading slash matters: a bare `data/` would also swallow backtester/data/,
# silently dropping the whole storage layer from every commit.
/data/
/runs/
/runs-adhoc/
*.parquet
*.db
*.sqlite3

# Signal delivery secrets
configs/**/telegram.json
configs/**/signals.yaml
configs/telegram.json
configs/signals.yaml

# Local archives of regenerable data
*.zip
